{
  "name": "@template/db",
  "version": "0.0.0",
  "main": "src/index.ts",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run generate && bun build src/index.ts --outdir ./dist --target node",
    "test": "bun test",
    "check-types": "tsc --noEmit --incremental",
    "generate": "prisma generate",
    "migrate": "prisma generate && prisma migrate dev",
    "deploy": "prisma generate && prisma migrate deploy",
    "studio": "prisma studio",
    "prisma": "dotenv -e ../../.env -- prisma"
  },
  "dependencies": {
    "@template/env": "workspace:*",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^16.0.0",
    "pg": "^8.13.1",
    "prisma": "^7.2.0",
    "prisma-zod-generator": "^2.1.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.8.2"
  },
  "prisma": {
    "schema": "./prisma/schemas"
  }
}
