{
  "name": "@atemplate/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx affected -t build",
    "build:all": "nx run-many -t build",
    "clear": "node ./scripts/clean.js",
    "dev": "nx run-many -t dev",
    "api:dev": "bun --preload ./apps/api/src/tracing.ts --watch apps/api/src/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "biome format --write .",
    "check": "oxlint .",
    "check:fix": "oxlint . --fix",
    "check-types": "nx run-many -t check-types",
    "test": "CI=true NX_TERMINAL_OUTPUT=static nx run-many -t test --projects=\"modules/*/__testing__\"",
    "test:ci": "CI=true NX_TERMINAL_OUTPUT=static nx run-many -t test --projects=\"modules/*/__testing__\"",
    "test:watch": "nx run-many -t test:watch --projects=\"modules/*/__testing__\"",
    "test:modules": "nx run-many -t test --projects=\"modules/*/__testing__\"",
    "create:app": "node scripts/add-app.js",
    "create:package:internal": "hygen create package-internal",
    "create:package:client": "hygen create package-client",
    "create:module": "hygen create module",
    "create:infrastructure": "node scripts/add-infrastructure.js",
    "db:migrate": "nx run db:migrate",
    "db:migrate:prod": "nx run db:deploy",
    "db:migrate:ci": "nx run db:deploy",
    "db:migrate:test": "nx run db:migrate --configuration=test",
    "db:generate": "nx run db:generate && nx run prisma-defs:transform",
    "db:generate:prod": "nx run db:generate --configuration=prod",
    "db:reset:test": "nx run db:reset --configuration=test",
    "db:dev": "nx run db:prisma --configuration=dev",
    "db:test": "nx run db:prisma --configuration=test",
    "db:prod": "nx run db:prisma --configuration=prod",
    "db": "nx run db:prisma",
    "ensure-prisma": "bun run db:generate:prod && bun run --filter=@template/prisma-defs transform",
    "ensure-prisma-ci": "bun run db:generate:prod && bun run --filter=@template/prisma-defs transform"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/**/*",
    "apps/*",
    "infrastructure/*",
    "infrastructure/**/*",
    "modules/*",
    "modules/**/*",
    "services/**/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@nx/js": "21.2.2",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "^22.15.3",
    "hygen": "^6.2.11",
    "lefthook": "^1.11.16",
    "nx": "21.2.2",
    "oxlint": "^1.65.0",
    "tslib": "^2.3.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "^22.17.1"
  },
  "packageManager": "bun@1.2.21"
}
